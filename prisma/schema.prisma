// Livyn — Christian Daily Companion App
// Data model. Postgres (Supabase) in dev and production, one DATABASE_URL.
// Role/status fields are plain Strings (not Prisma enums) so this schema
// stays portable if a provider ever needs SQLite again (no native enums there).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & Access ----------

/// role: "user" | "contributor" | "moderator" | "admin" | "super_admin" | "leader"
model User {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerified     Boolean  @default(false)
  passwordHash      String?
  name              String
  avatarUrl         String?
  role              String   @default("user")
  status            String   @default("active") // active | suspended | banned
  authProvider      String   @default("email") // email | google | apple
  googleId          String?  @unique
  appleId           String?  @unique
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?
  fontSize          String   @default("md")
  themePreference   String   @default("system") // light | dark | system
  language          String   @default("id")
  /// Legal consent. Null until the user accepts; termsVersion lets a future
  /// wording change re-ask only the people who accepted an older version.
  termsAcceptedAt   DateTime?
  termsVersion      String?
  /// 24 comma-separated counters, one per hour (Asia/Jakarta), recording when
  /// this user actually opens the app. Drives the smart-reminder suggestion.
  habitHours        String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contributorProfile ContributorProfile?
  leaderProfile      LeaderProfile?
  sessions           Session[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginEvent[]
  devices            Device[]
  devotions          Devotion[]        @relation("DevotionAuthor")
  sermons            Sermon[]          @relation("SermonAuthor")
  bookmarks          Bookmark[]
  highlights         Highlight[]
  notes              Note[]
  prayerReminders    PrayerReminder[]
  prayerLogs         PrayerLog[]
  notifications      Notification[]
  reportsFiled       Report[]          @relation("ReportFiler")
  auditLogs          AuditLog[]
  moderationActions  ModerationAction[] @relation("ModeratorActions")
  journalEntries     JournalEntry[]
  pushSubscriptions  PushSubscription[]
  challengeProgress  ChallengeProgress[]
  readingPlanEnrollments ReadingPlanEnrollment[]
  favoriteVerses     FavoriteVerse[]
  personalPrayers    PersonalPrayer[]
  dailyActivity      DailyActivity[]
  points             Int      @default(0)

  friendshipsRequested   Friendship[] @relation("FriendshipRequester")
  friendshipsReceived    Friendship[] @relation("FriendshipAddressee")
  friendInviteCodes      FriendInviteCode[]
  circlesOwned           Circle[]     @relation("CircleOwner")
  circleMemberships      CircleMember[]
  prayerRequests         PrayerRequest[]
  prayerIntercessions    PrayerIntercession[]
  versePingsSent         VersePing[]  @relation("VersePingFrom")
  versePingsReceived     VersePing[]  @relation("VersePingTo")
  missionsCreated        WeeklyMission[] @relation("MissionCreator")
  missionCheckIns        MissionCheckIn[]
  broadcastsAuthored     CircleBroadcast[] @relation("BroadcastAuthor")

  @@index([role])
}

model ContributorProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  bio          String?
  church       String?
  verified     Boolean  @default(false)
  suspended    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
}

model RefreshToken {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  family       String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedBy   String?
}

model LoginEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress  String?
  userAgent  String?
  location   String?
  success    Boolean
  reason     String?
  createdAt  DateTime @default(now())
}

model Device {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint  String
  name         String?
  lastSeenAt   DateTime @default(now())
  trusted      Boolean  @default(false)

  @@unique([userId, fingerprint])
}

// ---------- Content ----------

model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  icon      String?
  devotions Devotion[]
  sermons   Sermon[]
}

/// status: "draft" | "pending" | "published" | "rejected"
model Devotion {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  excerpt       String
  body          String
  bibleRefs     String   // comma-separated refs, e.g. "Yohanes 3:16, Mazmur 23:1"
  readingTimeMin Int     @default(3)
  coverImageUrl String?
  status        String   @default("draft")
  rejectReason  String?
  authorId      String
  author        User     @relation("DevotionAuthor", fields: [authorId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  publishDate   DateTime?
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookmarks     Bookmark[]

  @@index([status])
  @@index([publishDate])
}

model BibleBook {
  id           String   @id @default(cuid())
  code         String   @unique // e.g. "yoh"
  name         String   // e.g. "Yohanes"
  testament    String   // "old" | "new"
  orderIndex   Int
  chapterCount Int
  verses       BibleVerse[]

  @@index([testament, orderIndex])
}

model BibleVerse {
  id         String   @id @default(cuid())
  bookId     String
  book       BibleBook @relation(fields: [bookId], references: [id])
  chapter    Int
  verse      Int
  text       String
  translation String  @default("TB")

  journalEntries JournalEntry[]

  @@unique([bookId, chapter, verse, translation])
  @@index([bookId, chapter])
}

/// status: "draft" | "pending" | "published" | "rejected"
model Sermon {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  videoUrl      String
  thumbnailUrl  String?
  durationSec   Int      @default(0)
  pastor        String
  church        String?
  hasSubtitles  Boolean  @default(false)
  transcript    String?
  status        String   @default("draft")
  rejectReason  String?
  authorId      String
  author        User     @relation("SermonAuthor", fields: [authorId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  publishDate   DateTime?
  viewCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchProgress WatchProgress[]

  @@index([status])
}

model WatchProgress {
  id         String   @id @default(cuid())
  userId     String
  sermonId   String
  sermon     Sermon   @relation(fields: [sermonId], references: [id], onDelete: Cascade)
  positionSec Int     @default(0)
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@unique([userId, sermonId])
}

// ---------- Engagement ----------

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  devotionId String
  devotion   Devotion @relation(fields: [devotionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, devotionId])
}

model Highlight {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookCode   String
  chapter    Int
  verse      Int
  color      String   @default("gold")
  createdAt  DateTime @default(now())

  @@unique([userId, bookCode, chapter, verse])
}

model Note {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookCode   String
  chapter    Int
  verse      Int
  text       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// slot: "morning" | "lunch" | "evening" | "midnight" | "custom"
model PrayerReminder {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String
  slot        String
  time        String   // "HH:mm"
  daysOfWeek  String   // comma-separated 0-6
  ringtone    String   @default("default")
  repeat      Boolean  @default(true)
  verseAfter  Boolean  @default(true)
  active      Boolean  @default(true)
  /// When true the cron sends this reminder at the user's own habit hour
  /// instead of `time`, so a 06:00 reminder follows someone who always opens
  /// the app at 22:00 rather than shouting into an empty morning.
  autoAdjust  Boolean  @default(false)
  createdAt   DateTime @default(now())

  logs        PrayerLog[]
}

/// A verse the user chose to keep. Text and reference are denormalised so a
/// favourite survives even if the verse is later re-sourced from a different
/// Bible API.
model FavoriteVerse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookCode  String
  bookName  String
  chapter   Int
  verse     Int
  text      String
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, bookCode, chapter, verse])
  @@index([userId, createdAt])
}

/// One row per user per day per habit, powering the "today's rhythm" ring row
/// on Home. Only kinds with no other record of their own are stored here —
/// prayer and journal are read from PrayerLog and JournalEntry instead.
/// kind: "verse" | "devotion"
model DailyActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String   // "YYYY-MM-DD" in Asia/Jakarta
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, day, kind])
  @@index([userId, day])
}

/// A private prayer, separate from a Circle PrayerRequest which is shared.
/// status: "open" | "answered"
model PersonalPrayer {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  body         String?
  status       String    @default("open")
  answeredNote String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

model PrayerLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderId  String?
  reminder    PrayerReminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  prayedAt    DateTime @default(now())
  note        String?
}

// ---------- Platform ----------

/// type: "daily_verse" | "reminder" | "new_sermon" | "contributor_update" | "holiday" | "system"
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

/// status: "open" | "reviewed" | "dismissed"
model Report {
  id           String   @id @default(cuid())
  filedById    String
  filedBy      User     @relation("ReportFiler", fields: [filedById], references: [id])
  targetType   String   // "devotion" | "sermon" | "user"
  targetId     String
  reason       String
  status       String   @default("open")
  createdAt    DateTime @default(now())
}

model ModerationAction {
  id           String   @id @default(cuid())
  moderatorId  String
  moderator    User     @relation("ModeratorActions", fields: [moderatorId], references: [id])
  targetType   String
  targetId     String
  action       String // "approve" | "reject" | "suspend" | "edit"
  reason       String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Journal ("Curhat kepada Tuhan") ----------

/// mood: "damai" | "sukacita" | "bersyukur" | "sedih" | "cemas" | "marah" | "lelah" | "bingung"
model JournalEntry {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  body               String
  mood               String?
  suggestedVerseId   String?
  suggestedVerse     BibleVerse? @relation(fields: [suggestedVerseId], references: [id])
  suggestedVerseNote String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId, createdAt])
}

// ---------- Web Push ----------

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Monthly Reading Challenge / Leveling ----------

model ReadingChallenge {
  id          String   @id @default(cuid())
  title       String
  month       Int
  year        Int
  bookCode    String
  chapterFrom Int
  chapterTo   Int
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  progress ChallengeProgress[]

  @@unique([month, year])
}

model ChallengeProgress {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId   String
  challenge     ReadingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  chaptersRead  String    @default("") // comma-separated chapter numbers completed
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastReadAt    DateTime?
  pointsEarned  Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([userId, challengeId])
}

// ---------- Bible Reading Plans ----------

model ReadingPlan {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  coverEmoji  String   @default("📖")
  totalDays   Int
  category    String   @default("general") // general, gospel, wisdom, epistles, ot-history
  difficulty  String   @default("beginner") // beginner, intermediate, advanced
  schedule    String   // JSON: array of { day, bookCode, chapter, title? }
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  enrollments ReadingPlanEnrollment[]
}

model ReadingPlanEnrollment {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId         String
  plan           ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  completedDays  String    @default("") // comma-separated day numbers
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastReadAt     DateTime?
  pointsEarned   Int       @default(0)

  @@unique([userId, planId])
  @@index([userId])
}

// ---------- Community: Friends, Circles, Prayer, Leaders ----------

/// status: "accepted" | "blocked"
model Friendship {
  id           String   @id @default(cuid())
  requesterId  String
  requester    User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId  String
  addressee    User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       String   @default("accepted")
  createdAt    DateTime @default(now())

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// Short shareable code that lets someone become your friend without email lookup.
model FriendInviteCode {
  id           String   @id @default(cuid())
  code         String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  expiresAt    DateTime?
  usedById     String?
  usedAt       DateTime?
}

/// Verified pastor/leader profile. role="leader" on User is granted by admin
/// after review of the LeaderProfile.
model LeaderProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  churchName    String
  position      String
  denomination  String?
  city          String?
  phone         String?
  bio           String?
  verified      Boolean  @default(false)
  verifiedAt    DateTime?
  verifiedById  String?
  rejectReason  String?
  submittedAt   DateTime @default(now())
}

/// type: "friend" | "pastoral"
model Circle {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         String   @default("friend")
  ownerId      String
  owner        User     @relation("CircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  joinCode     String   @unique
  memberLimit  Int      @default(15)
  emoji        String   @default("🌿")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members      CircleMember[]
  prayers      PrayerRequest[]
  missions     WeeklyMission[]
  broadcasts   CircleBroadcast[]

  @@index([ownerId])
}

/// role: "member" | "co-leader" | "leader"
model CircleMember {
  id           String   @id @default(cuid())
  circleId     String
  circle       Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String   @default("member")
  joinedAt     DateTime @default(now())

  @@unique([circleId, userId])
  @@index([userId])
}

/// status: "open" | "answered" | "closed"
model PrayerRequest {
  id           String   @id @default(cuid())
  circleId     String
  circle       Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  body         String?
  isAnonymous  Boolean  @default(false)
  status       String   @default("open")
  answeredNote String?
  createdAt    DateTime @default(now())
  answeredAt   DateTime?

  intercessions PrayerIntercession[]

  @@index([circleId, status])
}

model PrayerIntercession {
  id                String        @id @default(cuid())
  prayerRequestId   String
  prayerRequest     PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayedAt          DateTime      @default(now())

  @@unique([prayerRequestId, userId])
}

/// A verse sent from one friend to another with an optional personal note.
model VersePing {
  id           String   @id @default(cuid())
  fromUserId   String
  fromUser     User     @relation("VersePingFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User     @relation("VersePingTo", fields: [toUserId], references: [id], onDelete: Cascade)
  verseRef     String
  verseText    String
  note         String?
  readAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([toUserId, readAt])
}

/// category: "reading" | "prayer" | "fasting" | "evangelism" | "service" | "custom"
model WeeklyMission {
  id           String   @id @default(cuid())
  circleId     String
  circle       Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User     @relation("MissionCreator", fields: [createdById], references: [id])
  title        String
  description  String
  category     String   @default("reading")
  startDate    DateTime @default(now())
  endDate      DateTime
  createdAt    DateTime @default(now())

  checkIns     MissionCheckIn[]

  @@index([circleId, endDate])
}

model MissionCheckIn {
  id           String        @id @default(cuid())
  missionId    String
  mission      WeeklyMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         String?
  completedAt  DateTime      @default(now())

  @@unique([missionId, userId])
}

/// type: "announcement" | "sermon_note" | "prayer_focus"
model CircleBroadcast {
  id           String   @id @default(cuid())
  circleId     String
  circle       Circle   @relation(fields: [circleId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User     @relation("BroadcastAuthor", fields: [createdById], references: [id])
  type         String   @default("announcement")
  title        String
  body         String
  bibleRefs    String?
  sundayDate   DateTime?
  createdAt    DateTime @default(now())

  @@index([circleId, createdAt])
}
