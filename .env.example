# Copy to .env and fill in real values for your environment.

# Postgres connection string (same DB for dev and production). Get this from
# your Supabase project: Project Settings -> Database -> Connection string
# (use the "Connection pooling" URI for serverless/Vercel deploys).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# REQUIRED. The data layer talks to Supabase over PostgREST, not over the
# Postgres wire protocol, so DATABASE_URL alone is not enough: it only supplies
# the project ref. Without this key every database call throws "Supabase is not
# configured" and /api/health returns 503 — the whole app, not just one feature.
# Get it from Supabase -> Project Settings -> API -> `anon` / `publishable` key.
# Safe to expose (it is the key browsers would carry); RLS is what protects the
# data. Set it in Vercel under BOTH Production and Preview.
SUPABASE_ANON_KEY=""

# Optional. Only needed when the project ref cannot be parsed out of
# DATABASE_URL — setting it skips that derivation entirely.
SUPABASE_URL=""

# Generate strong random secrets for production, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

NODE_ENV="development"

# Optional OAuth (not required for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web Push VAPID keys — generate your own with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# OpenRouter API key — powers AI Pastor chat and journal reflections.
# Get your key at https://openrouter.ai/keys (free models available).
OPENROUTER_API_KEY=""

# Optional: preferred AI Pastor model(s), comma-separated, best first. Anything
# OpenRouter no longer lists is skipped automatically, so this is only a hint.
# Defaults to the curated free list in src/lib/ai-pastor/model.ts.
AI_PASTOR_MODEL=""

# Pexels API key for verse image backgrounds (free).
# Get your key at https://www.pexels.com/api/new/
PEXELS_API_KEY=""

# API.Bible key for full Bible text (free).
# Register at https://scripture.api.bible and create an app to get your key.
# Without this, only seeded sample verses are available.
API_BIBLE_KEY=""

# Shared secret required to trigger /api/cron/push (set the same value as the
# Authorization header on your Vercel Cron Job / scheduler).
CRON_SECRET=""
