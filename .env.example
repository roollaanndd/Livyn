# Copy to .env and fill in real values for your environment.
#
# Nothing here has a working default. The app used to fall back to a hardcoded
# JWT secret and a hardcoded Supabase key when these were missing, so a typo in
# production silently produced forgeable sessions. Missing config now fails the
# request instead — set these before deploying.

# --- Required ---------------------------------------------------------------

# Postgres connection string (same DB for dev and production). Get this from
# your Supabase project: Project Settings -> Database -> Connection string
# (use the "Connection pooling" URI for serverless/Vercel deploys). Also used to
# derive SUPABASE_URL when that is not set explicitly.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Signs and verifies session access tokens. Generate with `openssl rand -base64 48`.
# Required in production — the app refuses to serve without it. In development a
# fixed dev-only value is substituted, with a warning on first use.
JWT_ACCESS_SECRET="change-me"

# Supabase API key. Every database call this app makes is a PostgREST request
# authenticated with this key, so treat it as a real credential: keep it out of
# version control, and make sure row-level security in the project actually
# constrains what it can reach.
# Copy from Supabase: Project Settings -> API -> Project API keys.
SUPABASE_ANON_KEY=""

# Optional explicit project URL. Derived from DATABASE_URL when left blank.
SUPABASE_URL=""

NODE_ENV="development"

# --- Push notifications -----------------------------------------------------

# Web Push VAPID keys — generate your own with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret required to trigger /api/cron/push (set the same value as the
# Authorization header on your scheduler — see .github/workflows/prayer-push.yml).
# While this is unset the endpoint refuses every caller.
CRON_SECRET=""

# --- Optional features ------------------------------------------------------

# OpenRouter API key — powers AI Pastor chat and journal reflections.
# Get your key at https://openrouter.ai/keys (free models available).
OPENROUTER_API_KEY=""

# Optional: preferred AI Pastor model(s), comma-separated, best first. Anything
# OpenRouter no longer lists is skipped automatically, so this is only a hint.
# Defaults to the curated free list in src/lib/ai-pastor/model.ts.
AI_PASTOR_MODEL=""

# Pexels API key for verse image backgrounds (free).
# Get your key at https://www.pexels.com/api/new/
PEXELS_API_KEY=""

# API.Bible key for full Bible text (free).
# Register at https://scripture.api.bible and create an app to get your key.
# Without this, only seeded sample verses are available.
API_BIBLE_KEY=""

# Optional OAuth. Listed for completeness — no sign-in route uses these yet.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Note: JWT_REFRESH_SECRET used to be listed here. Refresh tokens are opaque
# random strings stored as SHA-256 hashes, not JWTs, so nothing ever read it.
