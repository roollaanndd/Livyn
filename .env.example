# Copy to .env and fill in real values for your environment.

# Postgres connection string (same DB for dev and production). Get this from
# your Supabase project: Project Settings -> Database -> Connection string
# (use the "Connection pooling" URI for serverless/Vercel deploys).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Generate strong random secrets for production, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"

NODE_ENV="development"

# Optional OAuth (not required for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Web Push VAPID keys — generate your own with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Google Gemini API key for AI Pastor (free tier).
# Get your key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""

# Pexels API key for verse image backgrounds (free).
# Get your key at https://www.pexels.com/api/new/
PEXELS_API_KEY=""

# Shared secret required to trigger /api/cron/push (set the same value as the
# Authorization header on your Vercel Cron Job / scheduler).
CRON_SECRET=""
